{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "acs/adapter-import/1.0",
  "title": "Agentic Content System supervised adapter import",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "adapter",
    "status",
    "reviewer",
    "approval_hash",
    "approval_revision",
    "output",
    "manifest",
    "provenance"
  ],
  "properties": {
    "schema_version": {"type": "string", "enum": ["1.0"]},
    "project_id": {"type": "string", "minLength": 1},
    "adapter": {"type": "string", "minLength": 1},
    "adapter_version": {"type": "string"},
    "status": {"type": "string", "enum": ["approved"]},
    "reviewer": {"type": "string", "minLength": 1},
    "approval_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "approval_revision": {"type": "integer", "minimum": 1},
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes", "media"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "bytes": {"type": "integer", "minimum": 1},
        "media": {"type": "object"}
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "bytes": {"type": "integer", "minimum": 1}
      }
    },
    "provenance": {"type": "string", "minLength": 1},
    "imported_at": {"type": "string"}
  }
}
