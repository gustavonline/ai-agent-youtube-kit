{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "acs/semantic-evaluation/1.0",
  "title": "Agentic Content System semantic checkpoint evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evaluation_id", "project_id", "subject", "checkpoint", "result", "decision", "observable_checks", "required_evidence", "outcome", "failure_action", "evaluated_by", "evaluated_at"],
  "properties": {
    "schema_version": {"type": "string", "enum": ["1.0"]},
    "evaluation_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "subject": {"type": "string", "minLength": 1},
    "checkpoint": {"type": "string", "minLength": 1},
    "result": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["promise", "audience", "required_proof", "approval_hash", "approval_revision"],
      "properties": {
        "promise": {"type": "string", "minLength": 1},
        "audience": {"type": "string", "minLength": 1},
        "required_proof": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "approval_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "approval_revision": {"type": "integer", "minimum": 1}
      }
    },
    "observable_checks": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "subject", "passed", "observation"],
        "properties": {
          "id": {"type": "string", "enum": ["promise_delivery", "proof_delivery", "audience_relevance"]},
          "subject": {"type": "string", "minLength": 1},
          "passed": {"type": "boolean"},
          "observation": {"type": "string", "minLength": 1}
        }
      }
    },
    "required_evidence": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}},
    "outcome": {"type": "string", "enum": ["passed", "failed"]},
    "failure_action": {"type": "string", "minLength": 1},
    "evaluated_by": {"type": "string", "minLength": 1},
    "evaluated_at": {"type": "string", "minLength": 1}
  }
}
