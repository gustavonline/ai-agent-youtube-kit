{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "acs/edit-plan/1.0",
  "title": "Agentic Content System approved edit plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "project_id", "approval", "source", "long_form", "short_form", "points", "cta", "transcript_ref"],
  "properties": {
    "schema_version": {"type": "string", "enum": ["1.0"]},
    "plan_id": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "project_id": {"type": "string", "minLength": 1},
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "approved_by", "approved_at", "note", "approval_hash", "approval_revision"],
      "properties": {
        "status": {"type": "string", "enum": ["draft", "approved", "rejected"]},
        "approved_by": {"type": "string"},
        "approved_at": {"type": "string"},
        "note": {"type": "string"},
        "approval_hash": {"type": "string", "pattern": "^$|^[a-f0-9]{64}$"},
        "approval_revision": {"type": "integer", "minimum": 0}
      }
    },
    "source": {"type": "string", "minLength": 1},
    "long_form": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "output", "segments"],
      "properties": {
        "enabled": {"type": "boolean"},
        "output": {"type": "string", "minLength": 1},
        "start": {"type": "number", "minimum": 0},
        "duration": {"type": "number", "minimum": 0},
        "segments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "start", "duration"],
            "properties": {
              "source": {"type": "string", "minLength": 1},
              "start": {"type": "number", "minimum": 0},
              "duration": {"type": "number", "minimum": 0},
              "audio": {"type": "string", "enum": ["source", "primary", "mute"]},
              "overlay": {"type": "string", "minLength": 1}
            }
          }
        },
        "frame": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fit": {"type": "string", "enum": ["cover", "contain"]},
            "anchor": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "x": {"type": "number", "minimum": 0},
                "y": {"type": "number", "minimum": 0}
              }
            },
            "focal_point": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "x": {"type": "number", "minimum": 0},
                "y": {"type": "number", "minimum": 0}
              }
            }
          }
        }
      }
    },
    "short_form": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "output", "segments"],
      "properties": {
        "enabled": {"type": "boolean"},
        "output": {"type": "string", "minLength": 1},
        "start": {"type": "number", "minimum": 0},
        "duration": {"type": "number", "minimum": 0},
        "segments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "start", "duration"],
            "properties": {
              "source": {"type": "string", "minLength": 1},
              "start": {"type": "number", "minimum": 0},
              "duration": {"type": "number", "minimum": 0},
              "audio": {"type": "string", "enum": ["source", "primary", "mute"]},
              "overlay": {"type": "string", "minLength": 1}
            }
          }
        },
        "frame": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fit": {"type": "string", "enum": ["cover", "contain"]},
            "anchor": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "x": {"type": "number", "minimum": 0},
                "y": {"type": "number", "minimum": 0}
              }
            },
            "focal_point": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "x": {"type": "number", "minimum": 0},
                "y": {"type": "number", "minimum": 0}
              }
            }
          }
        }
      }
    },
    "points": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "proof": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "cta": {"type": "string", "minLength": 1},
    "transcript_ref": {"type": "string", "minLength": 1},
    "captions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "long": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "format": {"type": "string", "enum": ["srt", "vtt"]},
            "sidecar": {"type": "boolean"},
            "burn": {"type": "boolean"},
            "max_chars": {"type": "integer", "minimum": 1},
            "max_words": {"type": "integer", "minimum": 1},
            "case": {"type": "string", "enum": ["preserve", "upper", "lower", "title"]},
            "placement": {"type": "string", "enum": ["bottom", "top", "center"]},
            "font": {"type": "string"},
            "font_size": {"type": "integer", "minimum": 1},
            "color": {"type": "string", "minLength": 1},
            "outline_color": {"type": "string", "minLength": 1},
            "outline_width": {"type": "integer", "minimum": 0},
            "margin": {"type": "integer", "minimum": 0},
            "style": {"type": "object", "additionalProperties": false, "properties": {"font": {"type": "string"}, "font_size": {"type": "integer", "minimum": 1}, "color": {"type": "string", "minLength": 1}, "outline_color": {"type": "string", "minLength": 1}, "outline_width": {"type": "integer", "minimum": 0}, "placement": {"type": "string", "enum": ["bottom", "top", "center"]}, "margin": {"type": "integer", "minimum": 0}}},
            "chunking": {"type": "object", "additionalProperties": false, "properties": {"max_chars": {"type": "integer", "minimum": 1}, "max_words": {"type": "integer", "minimum": 1}, "case": {"type": "string", "enum": ["preserve", "upper", "lower", "title"]}}}
          }
        },
        "short": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "format": {"type": "string", "enum": ["srt", "vtt"]},
            "sidecar": {"type": "boolean"},
            "burn": {"type": "boolean"},
            "max_chars": {"type": "integer", "minimum": 1},
            "max_words": {"type": "integer", "minimum": 1},
            "case": {"type": "string", "enum": ["preserve", "upper", "lower", "title"]},
            "placement": {"type": "string", "enum": ["bottom", "top", "center"]},
            "font": {"type": "string"},
            "font_size": {"type": "integer", "minimum": 1},
            "color": {"type": "string", "minLength": 1},
            "outline_color": {"type": "string", "minLength": 1},
            "outline_width": {"type": "integer", "minimum": 0},
            "margin": {"type": "integer", "minimum": 0},
            "style": {"type": "object", "additionalProperties": false, "properties": {"font": {"type": "string"}, "font_size": {"type": "integer", "minimum": 1}, "color": {"type": "string", "minLength": 1}, "outline_color": {"type": "string", "minLength": 1}, "outline_width": {"type": "integer", "minimum": 0}, "placement": {"type": "string", "enum": ["bottom", "top", "center"]}, "margin": {"type": "integer", "minimum": 0}}},
            "chunking": {"type": "object", "additionalProperties": false, "properties": {"max_chars": {"type": "integer", "minimum": 1}, "max_words": {"type": "integer", "minimum": 1}, "case": {"type": "string", "enum": ["preserve", "upper", "lower", "title"]}}}
          }
        },
        "long_form": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "format": {"type": "string", "enum": ["srt", "vtt"]},
            "sidecar": {"type": "boolean"},
            "burn": {"type": "boolean"},
            "max_chars": {"type": "integer", "minimum": 1},
            "max_words": {"type": "integer", "minimum": 1},
            "case": {"type": "string", "enum": ["preserve", "upper", "lower", "title"]},
            "placement": {"type": "string", "enum": ["bottom", "top", "center"]},
            "font": {"type": "string"},
            "font_size": {"type": "integer", "minimum": 1},
            "color": {"type": "string", "minLength": 1},
            "outline_color": {"type": "string", "minLength": 1},
            "outline_width": {"type": "integer", "minimum": 0},
            "margin": {"type": "integer", "minimum": 0},
            "style": {"type": "object", "additionalProperties": false, "properties": {"font": {"type": "string"}, "font_size": {"type": "integer", "minimum": 1}, "color": {"type": "string", "minLength": 1}, "outline_color": {"type": "string", "minLength": 1}, "outline_width": {"type": "integer", "minimum": 0}, "placement": {"type": "string", "enum": ["bottom", "top", "center"]}, "margin": {"type": "integer", "minimum": 0}}},
            "chunking": {"type": "object", "additionalProperties": false, "properties": {"max_chars": {"type": "integer", "minimum": 1}, "max_words": {"type": "integer", "minimum": 1}, "case": {"type": "string", "enum": ["preserve", "upper", "lower", "title"]}}}
          }
        },
        "short_form": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "format": {"type": "string", "enum": ["srt", "vtt"]},
            "sidecar": {"type": "boolean"},
            "burn": {"type": "boolean"},
            "max_chars": {"type": "integer", "minimum": 1},
            "max_words": {"type": "integer", "minimum": 1},
            "case": {"type": "string", "enum": ["preserve", "upper", "lower", "title"]},
            "placement": {"type": "string", "enum": ["bottom", "top", "center"]},
            "font": {"type": "string"},
            "font_size": {"type": "integer", "minimum": 1},
            "color": {"type": "string", "minLength": 1},
            "outline_color": {"type": "string", "minLength": 1},
            "outline_width": {"type": "integer", "minimum": 0},
            "margin": {"type": "integer", "minimum": 0},
            "style": {"type": "object", "additionalProperties": false, "properties": {"font": {"type": "string"}, "font_size": {"type": "integer", "minimum": 1}, "color": {"type": "string", "minLength": 1}, "outline_color": {"type": "string", "minLength": 1}, "outline_width": {"type": "integer", "minimum": 0}, "placement": {"type": "string", "enum": ["bottom", "top", "center"]}, "margin": {"type": "integer", "minimum": 0}}},
            "chunking": {"type": "object", "additionalProperties": false, "properties": {"max_chars": {"type": "integer", "minimum": 1}, "max_words": {"type": "integer", "minimum": 1}, "case": {"type": "string", "enum": ["preserve", "upper", "lower", "title"]}}}
          }
        }
      }
    },
    "creative_direction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "references": {"type": "array", "items": {"type": "string"}},
        "rights_notes": {"type": "string"},
        "caption_choice": {"type": "string"},
        "framing_choice": {"type": "string"},
        "grade_choice": {"type": "string"},
        "callout_choice": {"type": "string"},
        "thumbnail_choice": {"type": "string"},
        "motion_choice": {"type": "string"},
        "lut": {
          "oneOf": [
            {"type": "string", "minLength": 1},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "preview_path", "approved", "approved_by"],
              "properties": {
                "path": {"type": "string", "minLength": 1},
                "preview_path": {"type": "string", "minLength": 1},
                "preview_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
                "approved": {"type": "boolean"},
                "approved_by": {"type": "string", "minLength": 1}
              }
            }
          ]
        }
      }
    },
    "notes": {"type": "string"}
  }
}
