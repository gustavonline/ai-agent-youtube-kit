{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "acs/edit-plan/1.0",
  "title": "Agentic Content System approved edit plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "project_id", "approval", "source", "long_form", "short_form", "points", "cta", "transcript_ref"],
  "properties": {
    "schema_version": {"type": "string", "enum": ["1.0"]},
    "plan_id": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "project_id": {"type": "string", "minLength": 1},
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "approved_by", "approved_at", "note", "approval_hash", "approval_revision"],
      "properties": {
        "status": {"type": "string", "enum": ["draft", "approved", "rejected"]},
        "approved_by": {"type": "string"},
        "approved_at": {"type": "string"},
        "note": {"type": "string"},
        "approval_hash": {"type": "string", "pattern": "^$|^[a-f0-9]{64}$"},
        "approval_revision": {"type": "integer", "minimum": 0}
      }
    },
    "source": {"type": "string", "minLength": 1},
    "long_form": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "output", "segments"],
      "properties": {
        "enabled": {"type": "boolean"},
        "output": {"type": "string", "minLength": 1},
        "start": {"type": "number", "minimum": 0},
        "duration": {"type": "number", "minimum": 0},
        "segments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "start", "duration"],
            "properties": {
              "source": {"type": "string", "minLength": 1},
              "start": {"type": "number", "minimum": 0},
              "duration": {"type": "number", "minimum": 0}
            }
          }
        }
      }
    },
    "short_form": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "output", "segments"],
      "properties": {
        "enabled": {"type": "boolean"},
        "output": {"type": "string", "minLength": 1},
        "start": {"type": "number", "minimum": 0},
        "duration": {"type": "number", "minimum": 0},
        "segments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "start", "duration"],
            "properties": {
              "source": {"type": "string", "minLength": 1},
              "start": {"type": "number", "minimum": 0},
              "duration": {"type": "number", "minimum": 0}
            }
          }
        }
      }
    },
    "points": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "proof": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "cta": {"type": "string", "minLength": 1},
    "transcript_ref": {"type": "string", "minLength": 1},
    "notes": {"type": "string"}
  }
}
