{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "acs/transcript-review/1.0",
  "title": "Agentic Content System reviewed transcript truth",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "project_id",
    "source",
    "status",
    "reviewer",
    "revision",
    "raw_transcript_sha256",
    "source_binding",
    "coverage",
    "segments",
    "content_hash"
  ],
  "properties": {
    "schema_version": {"type": "string", "enum": ["1.0"]},
    "record_type": {"type": "string", "const": "reviewed_truth"},
    "project_id": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["reviewed", "partially_reviewed", "rejected"]},
    "reviewer": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "reviewed_at": {"type": "string"},
    "raw_transcript_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "sources"],
      "properties": {
        "project_id": {"type": "string", "minLength": 1},
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256", "bytes"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "bytes": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "start", "end", "status"],
        "properties": {
          "source": {"type": "string", "minLength": 1},
          "start": {"type": "number", "minimum": 0},
          "end": {"type": "number", "minimum": 0},
          "status": {"type": "string", "enum": ["covered"]}
        }
      }
    },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["start", "end", "text", "source"],
        "properties": {
          "start": {"type": "number", "minimum": 0},
          "end": {"type": "number", "minimum": 0},
          "text": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "speaker": {"type": "string"},
          "words": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["start", "end", "text"],
              "properties": {
                "start": {"type": "number", "minimum": 0},
                "end": {"type": "number", "minimum": 0},
                "text": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    },
    "note": {"type": "string"},
    "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
