{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "acs/review-record/1.0",
  "title": "Agentic Content System bound static review record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "html",
    "html_sha256",
    "manifest_id",
    "manifest_sha256",
    "inspection_sha256",
    "manifest_approval_hash",
    "manifest_approval_revision",
    "approval_hash",
    "approval_revision",
    "policy_hash",
    "provenance_hash",
    "delivery_intent_hash",
    "publisher_handoff_path",
    "publisher_handoff_sha256",
    "verification_status",
    "verification_sha256"
  ],
  "properties": {
    "schema_version": {"type": "string", "enum": ["1.0"]},
    "project_id": {"type": "string", "minLength": 1},
    "html": {"type": "string", "const": "reports/review.html"},
    "html_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "manifest_id": {"type": "string"},
    "manifest_sha256": {"type": "string", "pattern": "^$|^[a-f0-9]{64}$"},
    "inspection_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "manifest_approval_hash": {"type": "string", "pattern": "^$|^[a-f0-9]{64}$"},
    "manifest_approval_revision": {"type": "integer", "minimum": 0},
    "approval_hash": {"type": "string", "pattern": "^$|^[a-f0-9]{64}$"},
    "approval_revision": {"type": "integer", "minimum": 0},
    "policy_hash": {"type": "string", "pattern": "^$|^[a-f0-9]{64}$"},
    "provenance_hash": {"type": "string", "pattern": "^$|^[a-f0-9]{64}$"},
    "delivery_intent_hash": {"type": "string", "pattern": "^$|^[a-f0-9]{64}$"},
    "publisher_handoff_path": {"type": "string", "const": "publish/publisher-handoff.json"},
    "publisher_handoff_sha256": {"type": "string", "pattern": "^$|^[a-f0-9]{64}$"},
    "verification_status": {"type": "string", "enum": ["not_packaged", "not_run", "passed"]},
    "verification_sha256": {"type": "string", "pattern": "^$|^[a-f0-9]{64}$"}
  }
}
