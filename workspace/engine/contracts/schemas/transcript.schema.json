{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "acs/transcript/1.1",
  "title": "Agentic Content System open transcript",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "segments"],
  "properties": {
    "schema_version": {"type": "string", "enum": ["1.0", "1.1"]},
    "source": {"type": "string", "minLength": 1},
    "language": {"type": "string"},
    "provider": {"type": "string"},
    "model": {"type": "string"},
    "record_type": {"type": "string", "enum": ["raw_asr", "raw_transcript"]},
    "status": {"type": "string", "enum": ["raw"]},
    "revision": {"type": "integer", "minimum": 1},
    "input_name": {"type": "string"},
    "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "project_id": {"type": "string"},
    "raw_transcript_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "sources"],
      "properties": {
        "project_id": {"type": "string", "minLength": 1},
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256", "bytes"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "bytes": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    },
    "note": {"type": "string"},
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["start", "end", "text"],
          "properties": {
            "start": {"type": "number", "minimum": 0},
            "end": {"type": "number", "minimum": 0},
            "text": {"type": "string", "minLength": 1},
            "speaker": {"type": "string"},
            "source": {"type": "string", "minLength": 1},
            "words": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["start", "end", "text"],
                "properties": {
                  "start": {"type": "number", "minimum": 0},
                  "end": {"type": "number", "minimum": 0},
                  "text": {"type": "string", "minLength": 1}
                }
              }
            }
          }
      }
    }
  }
}
