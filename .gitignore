.DS_Store
.env
.venv/
workspace/engine/.cache/
node_modules/
__pycache__/

# Local production media, transcripts, Studio exports, and work files.
workspace/productions/*/sources/*
workspace/productions/*/transcripts/*
workspace/productions/*/local-whisper/*
workspace/productions/*/edit/*
workspace/productions/*/exports/*

# Reference-analysis downloads and extracted frames.
workspace/references/**/download/
workspace/references/**/frames/
workspace/references/**/local-whisper/

# Large media stays local unless explicitly curated elsewhere.
*.mp4
*.mov
*.m4v
*.mkv
*.webm
*.wav
*.mp3
*.aiff
*.aac
*.srt
*.vtt
!workspace/engine/tests/fixtures/content-graph/artifacts/transcript.vtt
