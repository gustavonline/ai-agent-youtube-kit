{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "acs/content-project/1.0",
  "title": "Agentic Content System content project",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "title", "promise", "audience", "format", "content_group", "status", "sources", "transcript", "delivery_intent"],
  "properties": {
    "schema_version": {"type": "string", "enum": ["1.0"]},
    "project_id": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "title": {"type": "string", "minLength": 1},
    "promise": {"type": "string", "minLength": 1},
    "audience": {"type": "string", "minLength": 1},
    "format": {"type": "string", "enum": ["physical-guest-podcast", "solo-direct-to-camera", "screen-slides-miro", "physical-whiteboard", "ipad-tablet", "outdoor-plus-another-mode", "online-guest-podcast", "client-case-interview", "vlog"]},
    "content_group": {"type": "string", "enum": ["teach-explain", "prove-demonstrate", "converse-learn", "humanize-relate"]},
    "status": {"type": "string", "enum": ["draft", "planned", "in-progress", "ready-for-review", "complete"]},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "kind", "role", "rights"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "role": {"type": "string", "enum": ["primary", "supporting", "b-roll", "audio", "graphic"]},
          "rights": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "owner", "license", "source_url", "attribution"],
            "properties": {
              "status": {"type": "string", "enum": ["owned", "licensed", "public-domain", "cc0", "cc-by", "permission-pending", "unknown"]},
              "owner": {"type": "string", "minLength": 1},
              "license": {"type": "string", "minLength": 1},
              "source_url": {"type": "string"},
              "attribution": {"type": "string"}
            }
          }
        }
      }
    },
    "transcript": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "format"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "format": {"type": "string", "enum": ["acs-transcript/1.0", "whisper-json", "markdown"]}
      }
    },
    "delivery_intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "routes"],
      "properties": {
        "schema_version": {"type": "string", "enum": ["1.0"]},
        "routes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["channel", "delivery_mode"],
                "properties": {
                  "channel": {"type": "string", "minLength": 1},
                  "delivery_mode": {"type": "string", "enum": ["manual"]}
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["channel", "delivery_mode", "scheduled_at", "timezone"],
                "properties": {
                  "channel": {"type": "string", "minLength": 1},
                  "delivery_mode": {"type": "string", "enum": ["scheduled"]},
                  "scheduled_at": {"type": "string", "minLength": 1},
                  "timezone": {"type": "string", "minLength": 1}
                }
              }
            ]
          }
        }
      }
    },
    "notes": {"type": "string"}
  }
}
