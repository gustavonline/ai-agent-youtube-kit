{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "acs/brand/1.0",
  "title": "Agentic Content System brand and channel policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "brand_id", "name", "channel_intent", "cadence", "channels"],
  "properties": {
    "schema_version": {"type": "string", "enum": ["1.0"]},
    "brand_id": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "name": {"type": "string", "minLength": 1},
    "owner": {"type": "string"},
    "channel_intent": {"type": "string", "minLength": 1},
    "cadence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["core_videos_per_week", "planning_horizon_weeks", "useful_short_target"],
      "properties": {
        "core_videos_per_week": {"type": "integer", "minimum": 0},
        "planning_horizon_weeks": {"type": "integer", "minimum": 1},
        "useful_short_target": {"type": "integer", "minimum": 0},
        "note": {"type": "string"}
      }
    },
    "channels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "enabled", "reason", "allowed_asset_types"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9-]+$"},
          "enabled": {"type": "boolean"},
          "reason": {"type": "string", "minLength": 1},
          "allowed_asset_types": {
            "type": "array",
            "items": {"type": "string", "enum": ["long", "short", "text"]}
          }
        }
      }
    }
  }
}
